{
  "manifest_version": 3,
  "name": "DevTools Export",
  "version": "1.0.0",
  "description": "Export Console Logs, LocalStorage, HTTP requests from DevTools with headers, body, and response data for easy debugging and sharing.",
  "icons": {
    "16": "assets/icon/icon16.png",
    "32": "assets/icon/icon32.png",
    "48": "assets/icon/icon48.png",
    "128": "assets/icon/icon128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon/icon16.png",
      "32": "assets/icon/icon32.png",
      "48": "assets/icon/icon48.png",
      "128": "assets/icon/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
