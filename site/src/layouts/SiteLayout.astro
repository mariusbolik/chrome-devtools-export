---
import PirschAnalytics from "../components/PirschAnalytics.astro";

interface Props {
  canonical: string;
  description: string;
  title: string;
  bodyClass?: string;
  imageAlt?: string;
  imageHeight?: number;
  imageUrl?: string;
  imageWidth?: number;
  ogType?: "website" | "article";
  showHeader?: boolean;
}

const {
  bodyClass = "",
  canonical,
  description,
  imageAlt = "DevToolsExport Chrome extension preview",
  imageHeight = 560,
  imageUrl = "https://devtoolsexport.com/og-image.png",
  imageWidth = 1200,
  ogType = "website",
  showHeader = false,
  title,
} = Astro.props;
const bodyClassValue = [bodyClass, showHeader ? "content-page" : ""].filter(Boolean).join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DevTools" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DevToolsExport" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
    <PirschAnalytics />
  </head>
  <body class={bodyClassValue || undefined}>
    {
      showHeader && (
        <header class="site-header">
          <a class="site-brand" href="/">
            <img src="/favicon.svg" alt="" />
            <span>DevToolsExport</span>
          </a>
        </header>
      )
    }

    <slot />

    <footer class="site-footer">
      <span>&copy; 2026 Eyloo GmbH. All rights reserved.</span>
      <nav aria-label="Footer">
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
        <a href="/terms/">Terms</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #1e1e1e;
    --bg-light: #252526;
    --bg-panel: #202324;
    --bg-hover: #2a2d2e;
    --border: #3c3c3c;
    --border-strong: #4f5357;
    --text: #cccccc;
    --text-bright: #f3f3f3;
    --text-dim: #8f8f8f;
    --accent: #0e639c;
    --accent-hover: #1177bb;
    --green: #4ec9b0;
    --yellow: #dcdcaa;
    --red: #f48771;
    --blue: #569cd6;
    --shadow: rgba(0, 0, 0, 0.36);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 13px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body.content-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-size: 14px;
    line-height: 1.65;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .site-header {
    padding: 14px clamp(16px, 4vw, 56px);
    border-bottom: 1px solid var(--border);
    background: var(--bg-light);
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-bright);
    font-weight: 650;
  }

  .site-brand img {
    width: 28px;
    height: 28px;
  }

  body.content-page main {
    width: min(780px, calc(100vw - 32px));
    flex: 1;
    margin: 0 auto;
    padding: clamp(46px, 8vw, 82px) 0;
  }

  body.content-page .eyebrow {
    margin: 0 0 10px;
    color: var(--blue);
    font-family: "SF Mono", Monaco, Consolas, monospace;
    font-size: 11px;
    text-transform: uppercase;
  }

  body.content-page h1,
  body.content-page h2 {
    color: var(--text-bright);
    line-height: 1.1;
    letter-spacing: 0;
  }

  body.content-page h1 {
    margin: 0 0 24px;
    font-size: clamp(36px, 5vw, 56px);
  }

  body.content-page h2 {
    margin: 34px 0 8px;
    font-size: 22px;
  }

  body.content-page p {
    margin: 0 0 14px;
    overflow-wrap: anywhere;
  }

  body.content-page main a,
  .site-footer a:hover {
    color: var(--blue);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
    padding: 22px 16px;
    background: var(--bg-light);
    color: var(--text-dim);
  }

  body.content-page .site-footer {
    border-top: 1px solid var(--border);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 560px) {
    body.landing-page {
      font-size: 12px;
    }
  }
</style>
