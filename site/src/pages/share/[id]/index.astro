---
import { env } from "cloudflare:workers";
import { applyShareReadCacheHeaders } from "../../../lib/share-cache";
import { loadSharedSnapshot, type ShareApiEnv } from "../../../lib/share-api";
import { buildShareViewModel } from "../../../lib/share-view";

export const prerender = false;

const snapshot = await loadSharedSnapshot(Astro.params.id ?? "", env as unknown as ShareApiEnv);
if (!snapshot) {
  Astro.response.status = 404;
  Astro.response.headers.set("cache-control", "no-store");
} else {
  applyShareReadCacheHeaders(Astro.response.headers, snapshot.expiresAt);
}

const model = snapshot ? buildShareViewModel(snapshot) : null;

const formatDate = (value: string | undefined) => {
  if (!value) return "unknown";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" });
};

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DevTools" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{model ? model.seoTitle : "Snapshot not found"}</title>
  </head>
  <body>
    {
      !snapshot || !model ? (
        <main class="not-found">
          <h1>Snapshot not found</h1>
          <p>The share link is invalid or has expired.</p>
        </main>
      ) : (
        <main class="app-shell">
          <section class="details">
            <div class="sticky-shell">
              <header class="topbar">
                <div class="brand">
                  <img src="/favicon.svg" alt="" />
                  <div>
                    <h1>{model.title}</h1>
                    <a href={model.safeUrl}>{model.url}</a>
                  </div>
                </div>
                <div class="meta-chips">
                  <span class="chip strong">#{model.id}</span>
                  <span class="chip">
                    {model.browser.iconUrl && <img src={model.browser.iconUrl} alt="" />}
                    {model.browser.label}
                  </span>
                  <span class="chip">
                    {model.location.flagUrl && <img src={model.location.flagUrl} alt="" />}
                    {model.location.label}
                  </span>
                  <span class="chip countdown" id="expiryCountdown" data-expires-at={model.expiresAt} title={`Expires ${formatDate(model.expiresAt)}`}>
                    Expires in ...
                  </span>
                  <a class="chip link" href={`/api/share/${model.id}.json`}>JSON</a>
                </div>
              </header>

              <section class="summary-grid">
                {model.summaryCards.map((card) => (
                  <div class={`metric ${card.tone}`}>
                    <span>{card.label}</span>
                    <strong>{card.value}</strong>
                    <em>{card.detail}</em>
                  </div>
                ))}
              </section>

              <nav class="tabs" role="tablist" aria-label="Snapshot sections">
                <a id="triage-tab" href="#triage" role="tab" data-tab="triage" aria-controls="triage" aria-selected="true">Triage</a>
                <a id="page-tab" href="#page" role="tab" data-tab="page" aria-controls="page" aria-selected="false">Page Snapshot</a>
                <a id="console-tab" href="#console" role="tab" data-tab="console" aria-controls="console" aria-selected="false">Console</a>
                <a id="resources-tab" href="#resources" role="tab" data-tab="resources" aria-controls="resources" aria-selected="false">Resources</a>
                <a id="network-tab" href="#network" role="tab" data-tab="network" aria-controls="network" aria-selected="false">Network</a>
                <a id="storage-tab" href="#storage" role="tab" data-tab="storage" aria-controls="storage" aria-selected="false">Storage</a>
                <a id="performance-tab" href="#performance" role="tab" data-tab="performance" aria-controls="performance" aria-selected="false">Performance Summary</a>
                <a id="environment-tab" href="#environment" role="tab" data-tab="environment" aria-controls="environment" aria-selected="false">Environment</a>
                <a id="json-tab" href="#json" role="tab" data-tab="json" aria-controls="json" aria-selected="false">Raw JSON</a>
                <a id="ai-summary-tab" href="#ai-summary" role="tab" data-tab="ai-summary" aria-controls="ai-summary" aria-selected="false">AI Summary</a>
              </nav>
            </div>

            <div class="panel triage-panel" id="triage" data-panel="triage" role="tabpanel" aria-labelledby="triage-tab">
              <dl class="key-values">
                <div><dt>Captured</dt><dd>{formatDate(model.createdAt)}</dd></div>
                <div><dt>Expires</dt><dd>{formatDate(model.expiresAt)}</dd></div>
                <div><dt>Domain</dt><dd>{model.domain}</dd></div>
                <div><dt>Schema</dt><dd>{snapshot.schemaVersion}</dd></div>
              </dl>

              <section class={`capture-banner ${model.captureFidelity.tone}`}>
                <strong>{model.captureFidelity.label}</strong>
                <span>{model.captureFidelity.detail}</span>
              </section>

              <section class="ui-section">
                <h2>What likely failed</h2>
                {model.issues.items.length > 0 ? (
                  <div class="issue-list">
                    {model.issues.items.map((issue) => (
                      <a class={`issue-row ${issue.severity}`} href={`#${issue.targetAnchor || issue.targetTab}`}>
                        <span>{issue.severity}</span>
                        <strong>{issue.title}</strong>
                        <em>{issue.detail}</em>
                      </a>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No obvious console, network, or capture problems detected.</p>
                )}
              </section>

              <section class="ui-section">
                <h2>User device context</h2>
                <div class="kv-table">
                  {model.issues.deviceRows.map((row) => (
                    <div class="kv-row">
                      <span>{row.label}</span>
                      <code class={row.valueType}>{row.value}</code>
                    </div>
                  ))}
                </div>
              </section>

              <section class="ui-section">
                <h2>Privacy summary</h2>
                <div class="privacy-grid compact-grid">
                  {model.privacy.summaryRows.map((row) => (
                    <div class={`privacy-card ${row.tone}`}>
                      <span>{row.label}</span>
                      <strong>{row.value}</strong>
                    </div>
                  ))}
                </div>
                {model.privacy.detailRows.length > 0 && (
                  <details class="raw-details">
                    <summary><span>Grouped redactions and trims</span><em>{model.privacy.detailRows.length} groups</em></summary>
                    <div class="privacy-detail-table">
                      <div class="privacy-detail-row table-header"><span>Change</span><span>Count</span></div>
                      {model.privacy.detailRows.map((row) => (
                        <div class={`privacy-detail-row ${row.tone}`}>
                          <span>{row.label}</span>
                          <strong>{row.value}</strong>
                        </div>
                      ))}
                    </div>
                  </details>
                )}
              </section>
            </div>

            <div class="panel page-panel" id="page" data-panel="page" role="tabpanel" aria-labelledby="page-tab" hidden>
              <div class="status-grid">
                {model.cdp.statusRows.map((row) => (
                  <div class={`status-card ${row.tone}`}>
                    <span>{row.label}</span>
                    <strong>{row.value}</strong>
                  </div>
                ))}
              </div>

              {model.cdp.hasScreenshot && model.cdp.screenshot.src ? (
                <figure class="screenshot-frame">
                  <img class="screenshot" src={model.cdp.screenshot.src} alt="Captured page screenshot" />
                  <figcaption>Captured page screenshot</figcaption>
                </figure>
              ) : (
                null
              )}

              <section id="page-layout" class="ui-section" tabindex="-1">
                <h2>Layout</h2>
                {model.cdp.layoutRows.length > 0 ? (
                  <div class="kv-table">
                    {model.cdp.layoutRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No layout metrics captured</p>
                )}
              </section>

              {model.cdp.domSnapshot.state === "available" ? (
                <details id="page-dom-snapshot" class="raw-details" tabindex="-1">
                  <summary><span>DOM snapshot state</span><em>{model.cdp.domSnapshot.label}</em></summary>
                  <pre>{JSON.stringify(snapshot.cdp.domSnapshot, null, 2)}</pre>
                </details>
              ) : (
                <section id="page-dom-snapshot" class="ui-section" tabindex="-1">
                  <h2>DOM snapshot state</h2>
                  {model.cdp.domSnapshot.state === "redacted" ? (
                    <p class="empty compact">DOM snapshot was redacted before upload because it can contain private page text, attributes, and user-entered values.</p>
                  ) : (
                    <p class="empty compact">No DOM snapshot captured</p>
                  )}
                </section>
              )}
            </div>

            <div class="panel console-panel" id="console" data-panel="console" role="tabpanel" aria-labelledby="console-tab" hidden>
              <div class="toolbar">
                <button class="filter-chip active" type="button" data-console-filter="all">All {model.counts.console}</button>
                <button class="filter-chip error" type="button" data-console-filter="error">Errors {model.console.errorCount}</button>
                <button class="filter-chip warn" type="button" data-console-filter="warn">Warnings {model.console.warningCount}</button>
              </div>
              {model.console.rows.map((entry) => (
                <details id={entry.anchorId} class={`log-row ${entry.severity}`} data-console-severity={entry.severity} open={entry.severity === "error"} tabindex="-1">
                  <summary>
                    <span>{entry.type}</span>
                    <strong>{entry.message}</strong>
                    <em>{entry.frame}</em>
                    <time>{entry.timestamp}</time>
                  </summary>
                  <pre>{entry.text}</pre>
                </details>
              ))}
              {model.console.rows.length === 0 && <p class="empty">No console logs captured</p>}
            </div>

            <div class="panel resources-panel" id="resources" data-panel="resources" role="tabpanel" aria-labelledby="resources-tab" hidden>
              {model.sources.sections.length > 0 ? (
                model.sources.sections.map((section) => (
                  <details id={section.anchorId} class="source-group" open tabindex="-1">
                    <summary><span>{section.origin}</span><em>{section.rows.length} resources</em></summary>
                    <div class="asset-table">
                      <div class="asset-row table-header"><span>Type</span><span>Path</span><span>Duration</span></div>
                      {section.rows.map((resource) => (
                        <div class="asset-row">
                          <span>{resource.type}</span>
                          {resource.safeUrl !== "#" ? <a href={resource.safeUrl}>{resource.path}</a> : <span>{resource.path}</span>}
                          <span>{resource.duration}</span>
                        </div>
                      ))}
                    </div>
                  </details>
                ))
              ) : (
                <p class="empty">No page assets or resources captured</p>
              )}
            </div>

            <div class="panel network-panel" id="network" data-panel="network" role="tabpanel" aria-labelledby="network-tab" hidden>
              <section class={`capture-banner ${model.captureFidelity.tone}`}>
                <strong>{model.captureFidelity.label}</strong>
                <span>{model.captureFidelity.detail}</span>
              </section>
              <div class="network-table">
                <div class="network-row table-header"><span>Name</span><span>Status</span><span>Method</span><span>Source</span><span>Type</span><span>Size</span><span>Time</span></div>
                {model.network.details.map((request) => (
                  <details id={request.anchorId} class="network-item" tabindex="-1">
                    <summary class="network-row network-summary">
                      <span class="path"><span class="twisty" aria-hidden="true">›</span>{request.name}</span>
                      <span class={`status ${request.statusTone}`}>{request.statusLabel}</span>
                      <span class={`method ${request.methodClass}`}>{request.method}</span>
                      <span class={request.captureNote ? "source limited" : "source"}>{request.sourceLabel}</span>
                      <span>{request.type}</span>
                      <span>{request.size}</span>
                      <span>{request.time}</span>
                    </summary>
                    <div class="network-details">
                      {request.captureNote && <p class="capture-note">{request.captureNote}</p>}
                      {request.hasHeaders && <section class="ui-section">
                        <h2>Headers</h2>
                        <div class="headers-grid">
                          {request.requestHeaders.length > 0 && (
                            <>
                            <h3>Request Headers</h3>
                            {request.requestHeaders.map((header) => (
                              <div class="headers-row"><span>{header.name}</span><code>{header.value}</code></div>
                            ))}
                            </>
                          )}
                          {request.responseHeaders.length > 0 && (
                            <>
                            <h3>Response Headers</h3>
                            {request.responseHeaders.map((header) => (
                              <div class="headers-row"><span>{header.name}</span><code>{header.value}</code></div>
                            ))}
                            </>
                          )}
                        </div>
                      </section>}
                      {request.hasPayload && <section class="ui-section">
                        <h2>Payload</h2>
                        <pre>{request.requestBody}</pre>
                      </section>}
                      {request.hasResponse && <section class="ui-section">
                        <h2>Response</h2>
                        <pre>{request.responseBody}</pre>
                      </section>}
                      <section class="ui-section">
                        <h2>Timing</h2>
                        <div class="kv-table">
                          <div class="kv-row"><span>Source</span><code>{request.sourceLabel}</code></div>
                          <div class="kv-row"><span>Duration</span><code>{request.time}</code></div>
                          <div class="kv-row"><span>Size</span><code>{request.size}</code></div>
                        </div>
                      </section>
                    </div>
                  </details>
                ))}
              </div>
              {model.network.rows.length === 0 && <p class="empty">No requests captured</p>}
            </div>

            <div class="panel storage-panel" id="storage" data-panel="storage" role="tabpanel" aria-labelledby="storage-tab" hidden>
              <div class="application-layout">
                <aside class="app-tree">
                  <strong>Storage</strong>
                  {model.storage.sections.map((section) => <span>{section.label} ({section.rows.length})</span>)}
                </aside>
                <div class="application-content">
                  {model.storage.sections.map((section) => (
                    <details id={section.anchorId} class="storage-bucket" open={section.rows.length > 0} tabindex="-1">
                      <summary>
                        <span>{section.label}</span>
                        <em>{section.rows.length} {section.rows.length === 1 ? "entry" : "entries"}</em>
                      </summary>
                      {section.rows.length > 0 ? (
                        <div class="storage-table" role="table" aria-label={`${section.label} entries`}>
                          <div class="storage-row storage-header" role="row">
                            <span role="columnheader">Key</span>
                            <span role="columnheader">Value</span>
                          </div>
                          {section.rows.map((row) => (
                            <div class="storage-row" role="row">
                              <span class="storage-key" role="cell">{row.key}</span>
                              <code class={`storage-value ${row.valueType}`} role="cell">{row.value}</code>
                            </div>
                          ))}
                        </div>
                      ) : (
                        <p class="empty">No entries captured</p>
                      )}
                    </details>
                  ))}
                </div>
              </div>
            </div>

            <div class="panel performance-panel" id="performance" data-panel="performance" role="tabpanel" aria-labelledby="performance-tab" hidden>
              <section id="performance-document" class="ui-section" tabindex="-1">
                <h2>Document</h2>
                {model.performance.documentRows.length > 0 ? (
                  <div class="kv-table">
                    {model.performance.documentRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No document diagnostics captured</p>
                )}
              </section>

              <section id="performance-navigation" class="ui-section" tabindex="-1">
                <h2>Navigation timing</h2>
                {model.performance.navigationRows.length > 0 ? (
                  <div class="kv-table">
                    {model.performance.navigationRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No navigation timing captured</p>
                )}
              </section>

              <section id="performance-paint" class="ui-section" tabindex="-1">
                <h2>Paint timing</h2>
                {model.performance.paintRows.length > 0 ? (
                  <div class="kv-table">
                    {model.performance.paintRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No paint timing captured</p>
                )}
              </section>

              <section id="performance-cdp" class="ui-section" tabindex="-1">
                <h2>CDP performance metrics</h2>
                {model.performance.cdpRows.length > 0 ? (
                  <div class="kv-table">
                    {model.performance.cdpRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No CDP performance metrics captured</p>
                )}
              </section>

              {model.performance.slowResources.length > 0 && (
                <section id="performance-slow-resources" class="ui-section" tabindex="-1">
                  <h2>Slow resources</h2>
                  <div class="resource-table">
                    <div class="resource-row table-header"><span>Type</span><span>Path</span><span>Duration</span></div>
                    {model.performance.slowResources.map((resource) => (
                      <div class="resource-row">
                        <span>{resource.initiatorType}</span>
                        {resource.safeUrl !== "#" ? <a href={resource.safeUrl}>{resource.path}</a> : <span>{resource.path}</span>}
                        <span>{resource.duration}</span>
                      </div>
                    ))}
                  </div>
                </section>
              )}
            </div>

            <div class="panel environment-panel" id="environment" data-panel="environment" role="tabpanel" aria-labelledby="environment-tab" hidden>
              {model.environment.sections.map((section) => (
                <section id={section.anchorId} class="ui-section" tabindex="-1">
                  <h2>{section.label}</h2>
                  {section.rows.length > 0 ? (
                    <div class="kv-table">
                      {section.rows.map((row) => (
                        <div class="kv-row">
                          <span>{row.label}</span>
                          <code class={row.valueType}>{row.value}</code>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="empty compact">No values captured</p>
                  )}
                </section>
              ))}

              <section class="ui-section">
                <h2>Installed Extensions</h2>
                {model.environment.installedExtensions.length > 0 ? (
                  <div class="extensions-table">
                    <div class="extension-row table-header">
                      <span>Name</span><span>Version</span><span>Status</span><span>Type</span><span>Permissions</span>
                    </div>
                    {model.environment.installedExtensions.map((extension) => (
                      <div class="extension-row">
                        <span>
                          <strong>{extension.name}</strong>
                          <em>{extension.id}</em>
                        </span>
                        <span>{extension.version}</span>
                        <span class={extension.enabled === "Enabled" ? "status ok" : "status error"}>{extension.enabled}</span>
                        <span>{extension.type} / {extension.installType}</span>
                        <span>{extension.permissions}, {extension.hostPermissions}</span>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No installed extensions captured</p>
                )}
              </section>

              <details id="environment-raw" class="raw-details" tabindex="-1">
                <summary><span>Raw Environment</span><em>JSON</em></summary>
                <pre>{JSON.stringify({ environment: snapshot.environment, extension: snapshot.extension, installedExtensions: snapshot.installedExtensions }, null, 2)}</pre>
              </details>

              {model.cdp.errors.length > 0 && (
                <section id="environment-cdp-errors" class="ui-section" tabindex="-1">
                  <h2>CDP capture errors</h2>
                  <div class="error-list">
                    {model.cdp.errors.map((error) => <code>{error}</code>)}
                  </div>
                </section>
              )}
            </div>

            <div class="panel json-panel" id="json" data-panel="json" role="tabpanel" aria-labelledby="json-tab" hidden>
              <div class="toolbar toolbar-right">
                <a class="filter-chip action-chip" href={`/api/share/${model.id}.json`} download={`devtoolsexport-${model.id}.json`}>
                  <svg class="heroicon" data-heroicon="arrow-down-tray" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M7.5 12 12 16.5m0 0 4.5-4.5M12 16.5V3" />
                  </svg>
                  <span>Download JSON</span>
                </a>
              </div>
              <pre>{JSON.stringify(snapshot, null, 2)}</pre>
            </div>

            <div class="panel ai-summary-panel" id="ai-summary" data-panel="ai-summary" role="tabpanel" aria-labelledby="ai-summary-tab" hidden>
              <div class="toolbar toolbar-right">
                <button class="filter-chip action-chip" type="button" data-copy-target="aiSummaryText" data-copy-label="Copy Summary">
                  <svg class="heroicon" data-heroicon="clipboard-document" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                  </svg>
                  <span data-action-label>Copy Summary</span>
                </button>
              </div>
              <textarea id="aiSummaryText" class="ai-summary-text" readonly>{model.aiSummary}</textarea>
            </div>
          </section>
        </main>
      )
    }
    <script is:inline>
      (() => {
        const aliases = {
          issues: "triage",
          elements: "page",
          sources: "resources",
          application: "storage",
        };
        const tabs = Array.from(document.querySelectorAll("[data-tab]"));
        const panels = Array.from(document.querySelectorAll("[data-panel]"));
        const getHashKey = (hash) => {
          const value = (hash || "#triage").replace(/^#/, "") || "triage";
          try {
            return decodeURIComponent(value);
          } catch {
            return value;
          }
        };
        const normalizeTab = (hash) => {
          const key = getHashKey(hash);
          const target = document.getElementById(key);
          const ownerPanel = target?.closest("[data-panel]");
          if (ownerPanel) return ownerPanel.getAttribute("data-panel") || "triage";
          return aliases[key] || key;
        };
        const scrollTargetIntoPanelView = (target, panel) => {
          if (!(target instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;
          const panelRect = panel.getBoundingClientRect();
          const targetRect = target.getBoundingClientRect();
          const top = targetRect.top - panelRect.top + panel.scrollTop;
          panel.scrollTo({
            top: Math.max(0, top),
            left: panel.scrollLeft,
            behavior: "auto",
          });
          window.scrollTo({ top: 0, left: 0, behavior: "auto" });
        };
        const selectTab = (hash, focus = false) => {
          const targetKey = getHashKey(hash);
          const key = normalizeTab(hash);
          const selected = document.querySelector(`[data-tab="${key}"]`);
          const panel = document.querySelector(`[data-panel="${key}"]`);
          if (!selected || !panel) return;

          for (const tab of tabs) {
            const active = tab === selected;
            tab.setAttribute("aria-selected", String(active));
            tab.classList.toggle("active", active);
            tab.setAttribute("tabindex", active ? "0" : "-1");
          }

          for (const item of panels) {
            item.hidden = item !== panel;
          }

          const target = document.getElementById(targetKey);
          if (target && target !== panel) {
            const details = target.closest("details");
            if (details instanceof HTMLDetailsElement) details.open = true;
            if (target instanceof HTMLDetailsElement) target.open = true;
            scrollTargetIntoPanelView(target, panel);
            if (focus && target instanceof HTMLElement) target.focus();
          } else if (focus && selected instanceof HTMLElement) {
            selected.focus();
          }
        };

        selectTab(window.location.hash);
        window.addEventListener("hashchange", () => selectTab(window.location.hash, true));

        for (const tab of tabs) {
          tab.addEventListener("keydown", (event) => {
            if (!(event instanceof KeyboardEvent)) return;
            if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
            event.preventDefault();
            const current = tabs.indexOf(tab);
            const offset = event.key === "ArrowRight" ? 1 : -1;
            const next = tabs[(current + offset + tabs.length) % tabs.length];
            if (next instanceof HTMLAnchorElement) {
              next.click();
            }
          });
        }

        for (const item of document.querySelectorAll("details[id]")) {
          item.addEventListener("toggle", () => {
            if (!(item instanceof HTMLDetailsElement) || !item.open || !item.id) return;
            if (window.location.hash === `#${item.id}`) return;
            history.replaceState(null, "", `#${item.id}`);
            selectTab(`#${item.id}`);
          });
        }

        const consoleButtons = Array.from(document.querySelectorAll("[data-console-filter]"));
        const consoleRows = Array.from(document.querySelectorAll("[data-console-severity]"));
        for (const button of consoleButtons) {
          button.addEventListener("click", () => {
            const filter = button.getAttribute("data-console-filter") || "all";
            for (const item of consoleButtons) item.classList.toggle("active", item === button);
            for (const row of consoleRows) {
              const severity = row.getAttribute("data-console-severity");
              row.hidden = filter !== "all" && severity !== filter;
            }
          });
        }

        for (const button of document.querySelectorAll("[data-copy-target]")) {
          button.addEventListener("click", async () => {
            const targetId = button.getAttribute("data-copy-target") || "";
            const target = document.getElementById(targetId);
            const text = target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement
              ? target.value
              : target?.textContent || "";
            if (!text) return;

            const label = button.querySelector("[data-action-label]");
            const initialText = button.getAttribute("data-copy-label") || button.textContent || "Copy";
            const setActionLabel = (value) => {
              if (label) {
                label.textContent = value;
              } else {
                button.textContent = value;
              }
            };

            try {
              await navigator.clipboard.writeText(text);
              setActionLabel("Copied");
            } catch {
              if (target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement) {
                target.focus();
                target.select();
              }
              setActionLabel("Selected");
            }
            window.setTimeout(() => {
              setActionLabel(initialText);
            }, 1800);
          });
        }

        const el = document.getElementById("expiryCountdown");
        if (!el) return;

        const expiresAt = new Date(el.getAttribute("data-expires-at") || "").getTime();
        const format = (milliseconds) => {
          if (!Number.isFinite(milliseconds)) return "Expires unknown";
          if (milliseconds <= 0) return "Expired";

          const totalSeconds = Math.floor(milliseconds / 1000);
          const days = Math.floor(totalSeconds / 86400);
          const hours = Math.floor((totalSeconds % 86400) / 3600);
          const minutes = Math.floor((totalSeconds % 3600) / 60);
          const seconds = totalSeconds % 60;

          if (days > 0) return `Expires in ${days}d ${hours}h`;
          if (hours > 0) return `Expires in ${hours}h ${minutes}m`;
          if (minutes > 0) return `Expires in ${minutes}m ${seconds}s`;
          return `Expires in ${seconds}s`;
        };

        const render = () => {
          el.textContent = format(expiresAt - Date.now());
        };

        render();
        window.setInterval(render, 1000);
      })();
    </script>
  </body>
</html>

