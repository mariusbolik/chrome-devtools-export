---
import { env } from "cloudflare:workers";
import { loadSharedSnapshot, type ShareApiEnv } from "../../../lib/share-api";
import { buildShareViewModel } from "../../../lib/share-view";

export const prerender = false;

const snapshot = await loadSharedSnapshot(Astro.params.id ?? "", env as unknown as ShareApiEnv);
if (!snapshot) {
  Astro.response.status = 404;
}

const model = snapshot ? buildShareViewModel(snapshot) : null;

const formatDate = (value: string | undefined) => {
  if (!value) return "unknown";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" });
};

const pathFor = (url: string) => {
  try {
    const parsed = new URL(url);
    return `${parsed.pathname}${parsed.search}`;
  } catch {
    return url;
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{model ? model.seoTitle : "Snapshot not found"}</title>
  </head>
  <body>
    {
      !snapshot || !model ? (
        <main class="not-found">
          <h1>Snapshot not found</h1>
          <p>The share link is invalid or has expired.</p>
        </main>
      ) : (
        <main class="app-shell">
          <section class="details">
            <input checked id="tab-summary" name="tabs" type="radio" />
            <input id="tab-network" name="tabs" type="radio" />
            <input id="tab-console" name="tabs" type="radio" />
            <input id="tab-storage" name="tabs" type="radio" />
            <input id="tab-cdp" name="tabs" type="radio" />
            <input id="tab-environment" name="tabs" type="radio" />
            <input id="tab-json" name="tabs" type="radio" />

            <div class="sticky-shell">
              <header class="topbar">
                <div class="brand">
                  <img src="/assets/icon/icon.png" alt="" />
                  <div>
                    <h1>{model.title}</h1>
                    <a href={model.safeUrl}>{model.url}</a>
                  </div>
                </div>
                <div class="meta-chips">
                  <span class="chip strong">#{model.id}</span>
                  <span class="chip">
                    {model.browser.iconUrl && <img src={model.browser.iconUrl} alt="" />}
                    {model.browser.label}
                  </span>
                  <span class="chip">
                    {model.location.flagUrl && <img src={model.location.flagUrl} alt="" />}
                    {model.location.label}
                  </span>
                  <span class="chip countdown" id="expiryCountdown" data-expires-at={model.expiresAt} title={`Expires ${formatDate(model.expiresAt)}`}>
                    Expires in ...
                  </span>
                  <a class="chip link" href={`/api/share/${model.id}.json`}>JSON</a>
                </div>
              </header>

              <section class="summary-grid">
                <div class="metric">
                  <span>Network</span>
                  <strong>{model.counts.network}</strong>
                  <em>{model.counts.networkErrors} errors</em>
                </div>
                <div class="metric">
                  <span>Console</span>
                  <strong>{model.counts.console}</strong>
                  <em>{model.counts.consoleErrors} errors</em>
                </div>
                <div class="metric">
                  <span>Storage</span>
                  <strong>{model.counts.storageBuckets}</strong>
                  <em>buckets</em>
                </div>
                <div class="metric">
                  <span>Extensions</span>
                  <strong>{model.counts.installedExtensions}</strong>
                  <em>installed</em>
                </div>
                <div class="metric warn">
                  <span>Redactions</span>
                  <strong>{model.counts.redactions}</strong>
                  <em>{model.counts.truncations} trims</em>
                </div>
              </section>

              <nav class="tabs" aria-label="Snapshot sections">
                <label for="tab-summary">Summary</label>
                <label for="tab-network">Network</label>
                <label for="tab-console">Console</label>
                <label for="tab-storage">Storage</label>
                <label for="tab-cdp">DOM/CDP</label>
                <label for="tab-environment">Environment</label>
                <label for="tab-json">Raw JSON</label>
              </nav>
            </div>

            <div class="panel summary-panel">
              <dl class="key-values">
                <div><dt>Captured</dt><dd>{formatDate(model.createdAt)}</dd></div>
                <div><dt>Expires</dt><dd>{formatDate(model.expiresAt)}</dd></div>
                <div><dt>Domain</dt><dd>{model.domain}</dd></div>
                <div><dt>Schema</dt><dd>{snapshot.schemaVersion}</dd></div>
              </dl>
              <h2>Notices</h2>
              <div class="notice-list">
                {[...snapshot.redactions, ...snapshot.truncations].map((notice) => (
                  <div class="notice-row">
                    <span>{notice.path}</span>
                    <em>{notice.reason}</em>
                  </div>
                ))}
                {snapshot.redactions.length + snapshot.truncations.length === 0 && <p class="empty">No redactions or truncations recorded</p>}
              </div>
            </div>

            <div class="panel network-panel">
              <div class="row header-row"><span>Method</span><span>Status</span><span>Path</span><span>Time</span></div>
              {snapshot.network.map((request) => (
                <div class="row">
                  <span class={`method ${request.method.toLowerCase()}`}>{request.method}</span>
                  <span class={request.status >= 400 ? "status error" : request.status >= 300 ? "status redirect" : "status ok"}>{request.status}</span>
                  <span class="path">{pathFor(request.url)}</span>
                  <span>{request.time}ms</span>
                </div>
              ))}
              {snapshot.network.length === 0 && <p class="empty">No requests captured</p>}
            </div>

            <div class="panel console-panel">
              {snapshot.console.map((entry) => (
                <div class={`log-row ${entry.type}`}>
                  <span>{entry.type}</span>
                  <pre>{entry.text}</pre>
                </div>
              ))}
              {snapshot.console.length === 0 && <p class="empty">No console logs captured</p>}
            </div>

            <div class="panel storage-panel">
              {model.storage.sections.map((section) => (
                <details class="storage-bucket" open={section.rows.length > 0}>
                  <summary>
                    <span>{section.label}</span>
                    <em>{section.rows.length} {section.rows.length === 1 ? "entry" : "entries"}</em>
                  </summary>
                  {section.rows.length > 0 ? (
                    <div class="storage-table" role="table" aria-label={`${section.label} entries`}>
                      <div class="storage-row storage-header" role="row">
                        <span role="columnheader">Key</span>
                        <span role="columnheader">Value</span>
                      </div>
                      {section.rows.map((row) => (
                        <div class="storage-row" role="row">
                          <span class="storage-key" role="cell">{row.key}</span>
                          <code class={`storage-value ${row.valueType}`} role="cell">{row.value}</code>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="empty">No entries captured</p>
                  )}
                </details>
              ))}
            </div>

            <div class="panel cdp-panel">
              <div class="status-grid">
                {model.cdp.statusRows.map((row) => (
                  <div class={`status-card ${row.tone}`}>
                    <span>{row.label}</span>
                    <strong>{row.value}</strong>
                  </div>
                ))}
              </div>

              {model.cdp.screenshot.src && (
                <img class="screenshot" src={model.cdp.screenshot.src} alt="Captured page screenshot" />
              )}

              <section class="ui-section">
                <h2>Layout</h2>
                {model.cdp.layoutRows.length > 0 ? (
                  <div class="kv-table">
                    {model.cdp.layoutRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No layout metrics captured</p>
                )}
              </section>

              <section class="ui-section">
                <h2>Performance</h2>
                {model.cdp.performanceRows.length > 0 ? (
                  <div class="kv-table">
                    {model.cdp.performanceRows.map((row) => (
                      <div class="kv-row">
                        <span>{row.label}</span>
                        <code class={row.valueType}>{row.value}</code>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No performance metrics captured</p>
                )}
              </section>

              <section class="ui-section">
                <h2>Page Assets</h2>
                {model.cdp.assets.length > 0 ? (
                  <div class="asset-table">
                    <div class="asset-row table-header"><span>Type</span><span>Path</span></div>
                    {model.cdp.assets.map((asset) => (
                      <div class="asset-row">
                        <span>{asset.type}</span>
                        {asset.safeUrl !== "#" ? <a href={asset.safeUrl}>{asset.path}</a> : <span>{asset.path}</span>}
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No page assets captured</p>
                )}
              </section>

              <section class="ui-section">
                <h2>Page Resources</h2>
                {model.cdp.resources.length > 0 ? (
                  <div class="resource-table">
                    <div class="resource-row table-header"><span>Type</span><span>Path</span><span>Duration</span></div>
                    {model.cdp.resources.map((resource) => (
                      <div class="resource-row">
                        <span>{resource.initiatorType}</span>
                        {resource.safeUrl !== "#" ? <a href={resource.safeUrl}>{resource.path}</a> : <span>{resource.path}</span>}
                        <span>{resource.duration}</span>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No page resources captured</p>
                )}
              </section>

              {model.cdp.errors.length > 0 && (
                <section class="ui-section">
                  <h2>CDP Errors</h2>
                  <div class="error-list">
                    {model.cdp.errors.map((error) => <code>{error}</code>)}
                  </div>
                </section>
              )}

              <details class="raw-details">
                <summary><span>Raw CDP</span><em>JSON</em></summary>
                <pre>{JSON.stringify(snapshot.cdp, null, 2)}</pre>
              </details>
            </div>

            <div class="panel environment-panel">
              {model.environment.sections.map((section) => (
                <section class="ui-section">
                  <h2>{section.label}</h2>
                  {section.rows.length > 0 ? (
                    <div class="kv-table">
                      {section.rows.map((row) => (
                        <div class="kv-row">
                          <span>{row.label}</span>
                          <code class={row.valueType}>{row.value}</code>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="empty compact">No values captured</p>
                  )}
                </section>
              ))}

              <section class="ui-section">
                <h2>Installed Extensions</h2>
                {model.environment.installedExtensions.length > 0 ? (
                  <div class="extensions-table">
                    <div class="extension-row table-header">
                      <span>Name</span><span>Version</span><span>Status</span><span>Type</span><span>Permissions</span>
                    </div>
                    {model.environment.installedExtensions.map((extension) => (
                      <div class="extension-row">
                        <span>
                          <strong>{extension.name}</strong>
                          <em>{extension.id}</em>
                        </span>
                        <span>{extension.version}</span>
                        <span class={extension.enabled === "Enabled" ? "status ok" : "status error"}>{extension.enabled}</span>
                        <span>{extension.type} / {extension.installType}</span>
                        <span>{extension.permissions}, {extension.hostPermissions}</span>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="empty compact">No installed extensions captured</p>
                )}
              </section>

              <details class="raw-details">
                <summary><span>Raw Environment</span><em>JSON</em></summary>
                <pre>{JSON.stringify({ environment: snapshot.environment, extension: snapshot.extension, installedExtensions: snapshot.installedExtensions }, null, 2)}</pre>
              </details>
            </div>

            <div class="panel json-panel">
              <pre>{JSON.stringify(snapshot, null, 2)}</pre>
            </div>
          </section>
        </main>
      )
    }
    <script is:inline>
      (() => {
        const el = document.getElementById("expiryCountdown");
        if (!el) return;

        const expiresAt = new Date(el.getAttribute("data-expires-at") || "").getTime();
        const format = (milliseconds) => {
          if (!Number.isFinite(milliseconds)) return "Expires unknown";
          if (milliseconds <= 0) return "Expired";

          const totalSeconds = Math.floor(milliseconds / 1000);
          const days = Math.floor(totalSeconds / 86400);
          const hours = Math.floor((totalSeconds % 86400) / 3600);
          const minutes = Math.floor((totalSeconds % 3600) / 60);
          const seconds = totalSeconds % 60;

          if (days > 0) return `Expires in ${days}d ${hours}h`;
          if (hours > 0) return `Expires in ${hours}h ${minutes}m`;
          if (minutes > 0) return `Expires in ${minutes}m ${seconds}s`;
          return `Expires in ${seconds}s`;
        };

        const render = () => {
          el.textContent = format(expiresAt - Date.now());
        };

        render();
        window.setInterval(render, 1000);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #1e1e1e;
    --bg-light: #252526;
    --bg-hover: #2a2d2e;
    --border: #3c3c3c;
    --text: #cccccc;
    --text-dim: #808080;
    --accent: #0e639c;
    --accent-hover: #1177bb;
    --green: #4ec9b0;
    --yellow: #dcdcaa;
    --red: #f48771;
    --blue: #569cd6;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--text);
    font: 12px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  a {
    color: var(--blue);
    text-decoration: none;
  }

  .app-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .sticky-shell {
    position: sticky;
    top: 0;
    z-index: 10;
    flex: 0 0 auto;
    background: var(--bg);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    background: var(--bg-light);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand img {
    width: 32px;
    height: 32px;
  }

  h1 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .brand a {
    display: block;
    max-width: min(72vw, 900px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-dim);
  }

  .meta-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 24px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    white-space: nowrap;
  }

  .chip img {
    width: 14px;
    height: 14px;
  }

  .chip.strong {
    color: var(--green);
    font-family: "SF Mono", Monaco, monospace;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(120px, 1fr));
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .metric {
    min-height: 74px;
    padding: 10px 12px;
    border-right: 1px solid var(--border);
  }

  .metric span,
  .metric em {
    display: block;
    color: var(--text-dim);
    font-style: normal;
  }

  .metric strong {
    display: block;
    margin: 2px 0;
    color: var(--text);
    font-size: 24px;
    line-height: 1;
  }

  .metric.warn strong {
    color: var(--yellow);
  }

  .details {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .details > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs {
    display: flex;
    background: var(--bg-light);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .tabs label {
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
    color: var(--text-dim);
    cursor: pointer;
    white-space: nowrap;
  }

  #tab-summary:checked ~ .sticky-shell .tabs label[for="tab-summary"],
  #tab-network:checked ~ .sticky-shell .tabs label[for="tab-network"],
  #tab-console:checked ~ .sticky-shell .tabs label[for="tab-console"],
  #tab-storage:checked ~ .sticky-shell .tabs label[for="tab-storage"],
  #tab-cdp:checked ~ .sticky-shell .tabs label[for="tab-cdp"],
  #tab-environment:checked ~ .sticky-shell .tabs label[for="tab-environment"],
  #tab-json:checked ~ .sticky-shell .tabs label[for="tab-json"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .panel {
    display: none;
    flex: 1;
    min-height: 0;
    overflow: auto;
  }

  #tab-summary:checked ~ .summary-panel,
  #tab-network:checked ~ .network-panel,
  #tab-console:checked ~ .console-panel,
  #tab-storage:checked ~ .storage-panel,
  #tab-cdp:checked ~ .cdp-panel,
  #tab-environment:checked ~ .environment-panel,
  #tab-json:checked ~ .json-panel {
    display: block;
  }

  .key-values {
    display: grid;
    grid-template-columns: repeat(4, minmax(140px, 1fr));
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  .key-values div {
    padding: 10px 12px;
    border-right: 1px solid var(--border);
  }

  dt {
    color: var(--text-dim);
  }

  dd {
    margin: 2px 0 0;
  }

  h2 {
    margin: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .notice-row,
  .row,
  .log-row {
    display: grid;
    gap: 8px;
    padding: 6px 8px;
    border-bottom: 1px solid var(--border);
  }

  .notice-row {
    grid-template-columns: minmax(220px, 0.4fr) 1fr;
  }

  .notice-row span,
  .notice-row em,
  pre {
    font-family: "SF Mono", Monaco, monospace;
  }

  .notice-row em {
    color: var(--text-dim);
    font-style: normal;
  }

  .row {
    grid-template-columns: 72px 56px minmax(180px, 1fr) 70px;
    align-items: center;
  }

  .header-row {
    position: sticky;
    top: 0;
    background: var(--bg-light);
    color: var(--text-dim);
    font-size: 10px;
    text-transform: uppercase;
  }

  .method,
  .status {
    font-weight: 600;
    font-size: 10px;
  }

  .method.get,
  .status.ok {
    color: var(--green);
  }

  .method.post,
  .method.patch {
    color: var(--blue);
  }

  .method.put,
  .status.redirect {
    color: var(--yellow);
  }

  .method.delete,
  .status.error {
    color: var(--red);
  }

  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .log-row {
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: start;
    font-family: "SF Mono", Monaco, monospace;
  }

  .log-row span {
    color: var(--text-dim);
    font-size: 9px;
    text-transform: uppercase;
  }

  .log-row.warn {
    border-left: 2px solid var(--yellow);
    background: rgba(220, 220, 170, 0.05);
  }

  .log-row.error {
    border-left: 2px solid var(--red);
    background: rgba(244, 135, 113, 0.05);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    background: var(--bg-light);
    cursor: pointer;
  }

  summary em {
    color: var(--text-dim);
    font-style: normal;
  }

  .storage-table {
    display: grid;
    grid-template-columns: minmax(180px, 0.34fr) minmax(0, 1fr);
  }

  .storage-row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--border);
  }

  .storage-header {
    min-height: 28px;
    align-items: center;
    background: var(--bg-hover);
    color: var(--text-dim);
    font-size: 10px;
    text-transform: uppercase;
  }

  .storage-row span,
  .storage-value {
    min-width: 0;
    padding: 7px 10px;
  }

  .storage-key,
  .storage-value {
    font-family: "SF Mono", Monaco, monospace;
    overflow-wrap: anywhere;
  }

  .storage-key {
    color: var(--yellow);
    border-right: 1px solid var(--border);
  }

  .storage-value {
    display: block;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .storage-value.array,
  .storage-value.object {
    color: var(--green);
  }

  .storage-value.boolean,
  .storage-value.number {
    color: var(--blue);
  }

  .storage-value.null {
    color: var(--text-dim);
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    border-bottom: 1px solid var(--border);
  }

  .status-card {
    min-height: 66px;
    padding: 10px 12px;
    border-right: 1px solid var(--border);
    background: var(--bg);
  }

  .status-card span {
    display: block;
    color: var(--text-dim);
  }

  .status-card strong {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
  }

  .status-card.ok strong {
    color: var(--green);
  }

  .status-card.warn strong {
    color: var(--yellow);
  }

  .status-card.error strong {
    color: var(--red);
  }

  .ui-section {
    border-bottom: 1px solid var(--border);
  }

  .kv-table,
  .asset-table,
  .resource-table,
  .extensions-table {
    display: grid;
  }

  .kv-table {
    grid-template-columns: minmax(180px, 0.28fr) minmax(0, 1fr);
  }

  .asset-table {
    grid-template-columns: 110px minmax(0, 1fr);
  }

  .resource-table {
    grid-template-columns: 110px minmax(0, 1fr) 90px;
  }

  .extensions-table {
    grid-template-columns: minmax(220px, 1.2fr) 90px 86px 140px minmax(180px, 1fr);
  }

  .kv-row,
  .asset-row,
  .resource-row,
  .extension-row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--border);
  }

  .kv-row span,
  .kv-row code,
  .asset-row span,
  .asset-row a,
  .resource-row span,
  .resource-row a,
  .extension-row span {
    min-width: 0;
    padding: 7px 10px;
    overflow-wrap: anywhere;
  }

  .kv-row span:first-child,
