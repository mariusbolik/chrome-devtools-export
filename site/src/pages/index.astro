---
const description =
  "Create one-click bug reports with full Chrome DevTools snapshots, console logs, network requests, screenshots, browser context, and a free Chrome extension.";
const chromeWebStoreUrl = "https://chromewebstore.google.com/detail/devtools-export/pbdgpdjgngniklhkclaafnekfidohhbm";
const githubUrl = "https://github.com/mariusbolik/chrome-devtools-export";

const softwareApplicationJsonLd = JSON.stringify(
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "DevToolsExport",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Chrome",
    "description": description,
    "url": "https://devtoolsexport.com/",
    "image": "https://devtoolsexport.com/screenshots/chrome-export-panel.png",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
    },
  },
  null,
  2,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DevTools" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>DevToolsExport - Share Chrome DevTools Snapshots to Fix Bugs Faster</title>
    <meta name="description" content="Create one-click bug reports with full Chrome DevTools snapshots, console logs, network requests, screenshots, browser context, and a free Chrome extension." />
    <link rel="canonical" href="https://devtoolsexport.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="DevToolsExport - Share Chrome DevTools Snapshots to Fix Bugs Faster" />
    <meta property="og:description" content="Create one-click bug reports with full Chrome DevTools snapshots, console logs, network requests, screenshots, browser context, and a free Chrome extension." />
    <meta property="og:url" content="https://devtoolsexport.com/" />
    <meta property="og:image" content="https://devtoolsexport.com/screenshots/chrome-export-panel.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="DevToolsExport - Share Chrome DevTools Snapshots to Fix Bugs Faster" />
    <meta name="twitter:description" content="Create one-click bug reports with full Chrome DevTools snapshots, console logs, network requests, screenshots, browser context, and a free Chrome extension." />
    <meta name="twitter:image" content="https://devtoolsexport.com/screenshots/chrome-export-panel.png" />
    <script is:inline type="application/ld+json" set:html={softwareApplicationJsonLd}></script>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <nav class="topbar" aria-label="Primary">
          <a class="brand" href="/">
            <img src="/favicon.svg" alt="" />
            <span>DevToolsExport</span>
          </a>
          <div class="topbar-actions">
            <a href={githubUrl}>GitHub</a>
            <a class="small-cta" href={chromeWebStoreUrl}>Install</a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Free Chrome extension for better bug reports</p>
            <h1 id="hero-title">Export Content from Chrome DevTools</h1>
            <p class="hero-lede">
              Fix bugs faster when users hit a broken state. One click creates a complete, shareable DevTools snapshot with console logs,
              network requests, storage context, browser details, installed extensions, and an optional screenshot.
            </p>
            <div class="cta-row" aria-label="Primary actions">
              <a class="button primary" href={chromeWebStoreUrl}>
                <svg class="button-icon chrome-icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <title>chrome</title>
                  <g fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <circle cx="12" cy="12" r="4"></circle>
                    <path stroke-linecap="round" d="m8.534 14l-4.5-8M11.5 21.5l4-7.5M12 8h9"></path>
                  </g>
                </svg>
                <span>Install free Chrome extension</span>
              </a>
              <a class="button secondary" href={githubUrl}>
                <svg class="button-icon github-icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <title>github</title>
                  <path
                    fill="currentColor"
                    d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
                  ></path>
                </svg>
                <span>View on GitHub</span>
              </a>
            </div>
          </div>

          <figure class="screenshot-frame hero-shot">
            <img src="/screenshots/chrome-export-panel.png" alt="DevToolsExport panel showing captured page, console, network, storage, and environment data" />
          </figure>
        </div>
      </section>

      <section class="section solution" aria-labelledby="solution-title">
        <div class="section-inner solution-grid">
          <div class="text-stack">
            <p class="eyebrow">A one-click flow</p>
            <h2 id="solution-title">Create sharable bug reports in one click.</h2>
            <ol class="steps" aria-label="How DevToolsExport works">
              <li>
                <span>1</span>
                <strong>Install the extension</strong>
                <p>Add DevToolsExport to Chrome for free.</p>
              </li>
              <li>
                <span>2</span>
                <strong>Click Share Bug Report</strong>
                <p>Capture the current tab as a DevTools snapshot.</p>
              </li>
              <li>
                <span>3</span>
                <strong>Send the generated link</strong>
                <p>Developers open a focused report instead of chasing missing details.</p>
              </li>
            </ol>
          </div>
          <figure class="screenshot-frame compact-shot">
            <img src="/screenshots/extension-popup.png" alt="DevToolsExport popup with the Share Bug Report button and screenshot option" />
          </figure>
        </div>
      </section>

      <section class="section proof" aria-labelledby="captured-data-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="eyebrow">What developers receive</p>
            <h2 id="captured-data-title">Share links to the snapshot of your DevTools with developers to fix bug faster.</h2>
          </div>

          <div class="proof-carousel" data-proof-carousel>
            <div class="proof-stage" aria-label="Screenshot slideshow" aria-live="polite">
              <button class="proof-arrow proof-arrow-prev" type="button" data-proof-prev aria-label="Previous screenshot">
                <span aria-hidden="true">&lsaquo;</span>
              </button>

              <article id="proof-network-slide" data-proof-slide="network" class="proof-slide active">
                <figure class="browser-frame screenshot-frame">
                  <div class="browser-bar" aria-label="Share URL">
                    <span class="browser-controls" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="browser-url">https://devtoolsexport.com/share/a7k9m2q4/</span>
                  </div>
                  <img src="/screenshots/share-network.png" alt="Shared report network tab showing request status, method, source, type, size, and timing" />
                </figure>
                <div class="proof-copy">
                  <h3>Failed requests are visible immediately.</h3>
                  <p>Network requests include status, method, resource type, source, timing, and size so API and asset failures are easier to spot.</p>
                </div>
              </article>

              <article id="proof-console-slide" data-proof-slide="console" hidden class="proof-slide">
                <figure class="browser-frame screenshot-frame">
                  <div class="browser-bar" aria-label="Share URL">
                    <span class="browser-controls" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="browser-url">https://devtoolsexport.com/share/a7k9m2q4/</span>
                  </div>
                  <img src="/screenshots/share-console-logs.png" alt="Shared report console tab showing captured errors and warnings" />
                </figure>
                <div class="proof-copy">
                  <h3>Console errors travel with the report.</h3>
                  <p>Console logs, warnings, errors, stack traces, and page context stay attached to the exact bug report link.</p>
                </div>
              </article>

              <article id="proof-summary-slide" data-proof-slide="summary" hidden class="proof-slide">
                <figure class="browser-frame screenshot-frame">
                  <div class="browser-bar" aria-label="Share URL">
                    <span class="browser-controls" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="browser-url">https://devtoolsexport.com/share/a7k9m2q4/</span>
                  </div>
                  <img src="/screenshots/share-ai-summary.png" alt="Shared report AI summary tab with a compact debugging brief" />
                </figure>
                <div class="proof-copy">
                  <h3>A compact AI-ready summary is included.</h3>
                  <p>Each share includes a concise summary with console, network, environment, storage, and screenshot context for faster triage.</p>
                </div>
              </article>

              <button class="proof-arrow proof-arrow-next" type="button" data-proof-next aria-label="Next screenshot">
                <span aria-hidden="true">&rsaquo;</span>
              </button>
            </div>

            <div class="proof-dots" aria-label="Screenshot slides">
              <button class="proof-dot active" type="button" data-proof-dot="network" aria-label="Show network screenshot" aria-pressed="true"></button>
              <button class="proof-dot" type="button" data-proof-dot="console" aria-label="Show console screenshot" aria-pressed="false"></button>
              <button class="proof-dot" type="button" data-proof-dot="summary" aria-label="Show AI summary screenshot" aria-pressed="false"></button>
            </div>
          </div>
        </div>
      </section>

      <section class="section trust" aria-labelledby="free-title">
        <div class="section-inner trust-grid">
          <div>
            <p class="eyebrow">Free and privacy-conscious by default</p>
            <h2 id="free-title">A free extension for shareable Chrome DevTools snapshots.</h2>
          </div>
          <div class="trust-list">
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">
                <svg class="trust-icon-svg currency-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-2.88-2.17c1.44 1.2 4.32 1.2 5.76 0 1.5-1.25.55-3.83-2.88-3.83s-4.38-2.58-2.88-3.83c1.44-1.2 4.32-1.2 5.76 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                </svg>
              </span>
              <div>
                <strong>Completely free</strong>
                <p>Install the Chrome extension and create share links without a paid plan.</p>
              </div>
            </div>
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">
                <svg class="trust-icon-svg clock-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                </svg>
              </span>
              <div>
                <strong>Unlisted, expiring links</strong>
                <p>Share URLs are unlisted and snapshots expire instead of remaining available indefinitely.</p>
              </div>
            </div>
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">
                <svg class="trust-icon-svg shield-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.04a11.96 11.96 0 0 0 7.5 2.65c.18 2.7-.37 5.63-1.63 8.12C16.7 15.8 14.84 17.8 12 19.5c-2.84-1.7-4.7-3.7-5.87-6.02C4.87 11 4.32 8.06 4.5 5.36A11.96 11.96 0 0 0 12 2.71Z"></path>
                </svg>
              </span>
              <div>
                <strong>Default sensitive-value redaction</strong>
                <p>Secrets, cookies, request bodies, response bodies, DOM snapshots, and sensitive query parameters are redacted by default.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bottom-install" aria-label="Install DevToolsExport">
        <a class="button primary giant-store-button" href={chromeWebStoreUrl}>
          <svg class="button-icon chrome-icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <title>chrome</title>
            <g fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="4"></circle>
              <path stroke-linecap="round" d="m8.534 14l-4.5-8M11.5 21.5l4-7.5M12 8h9"></path>
            </g>
          </svg>
          <span>Install free Chrome extension</span>
        </a>
      </section>

      <section class="creator-follow" aria-labelledby="creator-title">
        <div class="creator-inner">
          <div>
            <p class="eyebrow">Creator</p>
            <h2 id="creator-title">Follow the creator</h2>
          </div>
          <div class="creator-links">
            <a class="creator-link" href="https://x.com/mariusbolik">
              <svg class="social-icon x-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M18.24 2H21.5l-7.1 8.12L22.75 22h-6.54l-5.12-6.7L5.23 22H1.98l7.6-8.69L1.5 2h6.7l4.63 6.12L18.24 2Zm-1.14 17.9h1.8L7.22 4H5.29L17.1 19.9Z"></path>
              </svg>
              <span>@mariusbolik</span>
            </a>
            <a class="creator-link" href="https://www.linkedin.com/in/marius-bolik/">
              <svg class="social-icon linkedin-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M6.94 8.98H3.74V20h3.2V8.98ZM5.34 4a1.86 1.86 0 1 0 0 3.72A1.86 1.86 0 0 0 5.34 4Zm6.83 4.98H9.11V20h3.2v-5.45c0-1.44.27-2.83 2.05-2.83 1.76 0 1.78 1.64 1.78 2.92V20h3.2v-6.04c0-2.96-.64-5.24-4.1-5.24-1.66 0-2.78.91-3.24 1.78h-.04l.21-1.52Z"></path>
              </svg>
              <span>Marius Bolik</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>&copy; 2026 Eyloo GmbH. All rights reserved.</span>
    </footer>
    <script is:inline>
      (() => {
        for (const carousel of document.querySelectorAll("[data-proof-carousel]")) {
          const slides = Array.from(carousel.querySelectorAll("[data-proof-slide]"));
          const dots = Array.from(carousel.querySelectorAll("[data-proof-dot]"));
          let currentIndex = Math.max(0, slides.findIndex((slide) => !slide.hidden));

          const select = (nextIndex) => {
            currentIndex = (nextIndex + slides.length) % slides.length;

            for (const [index, slide] of slides.entries()) {
              const active = index === currentIndex;
              slide.hidden = !active;
              slide.classList.toggle("active", active);
            }

            for (const [index, dot] of dots.entries()) {
              const active = index === currentIndex;
              dot.classList.toggle("active", active);
              dot.setAttribute("aria-pressed", String(active));
            }
          };

          for (const [index, dot] of dots.entries()) {
            dot.addEventListener("click", () => select(index));
          }

          carousel.querySelector("[data-proof-prev]")?.addEventListener("click", () => select(currentIndex - 1));
          carousel.querySelector("[data-proof-next]")?.addEventListener("click", () => select(currentIndex + 1));
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #1e1e1e;
    --bg-light: #252526;
    --bg-panel: #202324;
    --bg-hover: #2a2d2e;
    --border: #3c3c3c;
    --border-strong: #4f5357;
    --text: #cccccc;
    --text-bright: #f3f3f3;
    --text-dim: #8f8f8f;
    --accent: #0e639c;
    --accent-hover: #1177bb;
    --green: #4ec9b0;
    --yellow: #dcdcaa;
    --red: #f48771;
    --blue: #569cd6;
    --shadow: rgba(0, 0, 0, 0.36);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 13px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .hero {
    min-height: min(760px, 88svh);
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(180deg, rgba(14, 99, 156, 0.12), transparent 38%),
      var(--bg);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 58px;
    padding: 12px clamp(16px, 4vw, 56px);
    border-bottom: 1px solid var(--border);
    background: rgba(37, 37, 38, 0.92);
  }

  .brand,
  .topbar-actions,
  .cta-row {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 10px;
    color: var(--text-bright);
    font-size: 14px;
    font-weight: 650;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .topbar-actions {
    gap: 10px;
    color: var(--text-dim);
    font-size: 12px;
  }

  .topbar-actions a {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    border: 1px solid transparent;
  }

  .topbar-actions a:hover {
    color: var(--text);
  }

  .small-cta {
    padding: 4px 10px;
    border-color: var(--border-strong) !important;
    border-radius: 4px;
    background: var(--bg);
    color: var(--text) !important;
  }

  .hero-grid,
  .section-inner {
    width: min(1180px, calc(100vw - 32px));
    margin: 0 auto;
  }

  .hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(420px, 1.14fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding: clamp(42px, 7vw, 86px) 0 clamp(34px, 5vw, 60px);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--green);
    font-family: "SF Mono", Monaco, Consolas, monospace;
    font-size: 11px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    color: var(--text-bright);
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1;
    font-weight: 750;
    letter-spacing: 0;
    word-break: keep-all;
  }

  .hero-lede {
    max-width: 640px;
    margin: 22px 0 0;
    color: var(--text);
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.45;
  }

  .cta-row {
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .button {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-weight: 650;
  }

  .button-icon {
    width: 1.1em;
    height: 1.1em;
    flex: 0 0 auto;
  }

  .button.primary .button-icon {
    color: #ffffff;
  }

  .button.primary {
    border-color: var(--accent-hover);
    background: var(--accent);
    color: #ffffff;
  }

  .button.primary:hover {
    background: var(--accent-hover);
  }

  .button.secondary {
    background: var(--bg-light);
    color: var(--text);
  }

  .button.secondary:hover {
    border-color: var(--blue);
    color: var(--text-bright);
  }

  .screenshot-frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-light);
    box-shadow: 0 20px 60px var(--shadow);
  }

  .screenshot-frame img {
    width: 100%;
    height: auto;
  }

  .browser-frame {
    background: #151718;
  }

  .browser-bar {
    min-height: 34px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 7px 10px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-hover);
  }

  .browser-controls {
    display: flex;
    gap: 6px;
  }

  .browser-controls span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
  }

  .browser-controls span:nth-child(1) {
    background: var(--red);
  }

  .browser-controls span:nth-child(2) {
    background: var(--yellow);
  }

  .browser-controls span:nth-child(3) {
    background: var(--green);
  }

  .browser-url {
    min-width: 0;
    display: block;
    padding: 3px 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-family: "SF Mono", Monaco, Consolas, monospace;
    font-size: 11px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-shot {
    align-self: center;
  }

  .section {
    border-bottom: 1px solid var(--border);
  }

  .section-inner {
    padding: clamp(56px, 8vw, 92px) 0;
  }

  .solution-grid,
  .trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 72px);
