<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DevTools Export Share</title>
  </head>
  <body>
    <main>
      <img src="/assets/icon/icon.png" alt="" />
      <h1>DevTools Export Share</h1>
      <p>Open a shared DevTools snapshot URL to inspect exported debugging data.</p>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #1e1e1e;
    --bg-light: #252526;
    --border: #3c3c3c;
    --text: #cccccc;
    --text-dim: #808080;
    --accent: #0e639c;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--text);
    font: 12px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  main {
    width: min(360px, calc(100vw - 32px));
    padding: 16px;
    border: 1px solid var(--border);
    background: var(--bg-light);
    border-radius: 4px;
  }

  img {
    width: 40px;
    height: 40px;
  }

  h1 {
    margin: 8px 0 4px;
    font-size: 16px;
  }

  p {
    margin: 0;
    color: var(--text-dim);
  }
</style>
