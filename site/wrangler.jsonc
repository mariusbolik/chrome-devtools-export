{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devtools-export",
  "account_id": "f525f4afbff19582070c39b3ed311771",
  "compatibility_date": "2026-07-06",
  "workers_dev": false,
  "assets": {
    "directory": "./dist"
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://devtoolsexport.com"
  },
  "routes": [
    {
      "pattern": "devtoolsexport.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "devtools-export-shares",
      "remote": true
    }
  ]
}
